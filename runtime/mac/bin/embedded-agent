#!/usr/bin/env bash
set -euo pipefail

host="${EMBEDDED_AGENT_HOST:-}"
remote_prefix="${EMBEDDED_AGENT_REMOTE_PREFIX:-}"
remote_script="${EMBEDDED_AGENT_REMOTE_SCRIPT:-}"
connect_timeout="${EMBEDDED_AGENT_CONNECT_TIMEOUT:-8}"

if [[ -n "$remote_prefix" ]]; then
  remote_script="${remote_script:-${remote_prefix}\\bin\\embedded-agent.py}"
fi

usage() {
  cat <<'USAGE'
Usage:
  embedded-agent status --json
  embedded-agent project discover --project <id> --workspace <win-path> --json
  embedded-agent project discover --project <id> --workspace <win-path> --keil-project <relative-uvprojx> --write-background --json
  embedded-agent project show --project <id> --json
  embedded-agent project check-stale --project <id> --json
  embedded-agent device list --project <id> --json
  embedded-agent device serial-inspect --project <id> --tty <tty> [--serial <adb-serial>] --json
  embedded-agent knowledge build --project <id> --write --json
  embedded-agent knowledge show --project <id> --json
  embedded-agent tool resolve-path --project <id> --path <path> --json
  embedded-agent tool stat --project <id> --path <path> [--sha256] --json
  embedded-agent tool list --project <id> --path <path> [--max-entries 200] --json
  embedded-agent tool find --project <id> --root <path> --glob <glob> --json
  embedded-agent tool rg --project <id> --pattern <text> [--root <path>] [--glob <glob>] [--max-bytes 1048576] --json
  embedded-agent tool read --project <id> --path <path> [--max-bytes 65536] --json
  embedded-agent tool tail --project <id> --path <path> [--lines 200] --json
  embedded-agent tool first-failure --project <id> --path <path> --json
  embedded-agent git root --project <id> [--root <path>] --json
  embedded-agent git status --project <id> [--root <path>] --json
  embedded-agent git diff-summary --project <id> [--root <path>] [--staged] --json
  embedded-agent git diff --project <id> [--root <path>] [--path <path>] [--staged] --json
  embedded-agent git log --project <id> [--root <path>] [--limit 20] --json
  embedded-agent git show --project <id> [--root <path>] [--rev HEAD] [--stat] [--no-patch] --json
  embedded-agent git ls-files --project <id> [--root <path>] [--glob <glob>] --json
  embedded-agent git clone --project <id> --workspace <win-path> --url <git-url> --path <relative-path> --commit <full-sha> --confirm --json
  embedded-agent git sync --project <id> --path <relative-path> --commit <full-sha> --confirm --json
  embedded-agent git switch --project <id> --path <relative-path> --branch <name> --commit <full-sha> --confirm --json
  embedded-agent git create-branch --project <id> --path <relative-path> --branch <name> --commit <full-sha> --confirm --json
  embedded-agent git commit --project <id> --path <relative-path> --branch <name> --message <single-line> --include <repo-path> [--include <repo-path> ...] --confirm --json
  embedded-agent sdk status --json
  embedded-agent sdk list --json
  embedded-agent sdk search --query <project-or-sdk> [--limit 10] --json
  embedded-agent sdk components --sdk <name> [--component <path>] [--max-entries 200] --json
  embedded-agent sdk project-resolve --project <id> [--ci-dir <path>] --json
  embedded-agent sdk project-pull --project <id> [--ci-dir <path>] [--sdk-name <sdk>] [--sdk-version <version>] --confirm --json
  embedded-agent sdk materialize --project <id> --sdk <name> --component <path> --to <project-path> [--mode junction|copy] [--replace-managed] --confirm --json
  embedded-agent sdk check-mapping --project <id> --sdk <name> --component <path> --to <project-path> [--mode junction|copy] --json
  embedded-agent job start --project <id> --kind build --target keil|mpu [--sdk-path <project-path>] --json
  embedded-agent job start --project <id> --kind jenkins-wait --connection-id <connection-id> --job <name> --build <number> [--wait-timeout 2700] --json
  embedded-agent job status --job-id <job-id> --json
  embedded-agent job output --job-id <job-id> [--stream stdout|stderr|runner] [--offset 0] [--max-bytes 65536] --json
  embedded-agent job cancel --job-id <job-id> --confirm --json
  embedded-agent job list [--project <id>] [--limit 20] --json
  embedded-agent jenkins --connection-id <connection-id> auth-check --json
  embedded-agent jenkins --connection-id <connection-id> job-inspect --job <name> --json
  embedded-agent jenkins --connection-id <connection-id> parameters --job <name> --build <number> --json
  embedded-agent jenkins --connection-id <connection-id> build-start --job <name> --from-build <number> [--set NAME=VALUE] --confirm --json
  embedded-agent jenkins --connection-id <connection-id> build-status --job <name> --build <number> --json
  embedded-agent jenkins --connection-id <connection-id> build-wait --job <name> --build <number> [--wait-timeout 2700] --json
  embedded-agent jenkins --connection-id <connection-id> console-tail --job <name> --build <number> [--max-chars 12000] --json
  embedded-agent artifact download --connection-id <connection-id> --project <id> --url <artifact-url> --to <project-path> --sha256 <digest> --confirm --json
  embedded-agent build --project <id> --target keil|mpu [--sdk-path <project-path>] --json
  embedded-agent log tail --project <id> --kind build|serial|flash --since 10m --json
  embedded-agent log import --project <id> --task <task-id> --label <label> --source <desktop-log-path> --confirm --json
  embedded-agent log stat --project <id> --artifact <artifact-id> --json
  embedded-agent log read --project <id> --artifact <artifact-id> [--offset 0] [--max-bytes 65536] --json
  embedded-agent log rg --project <id> --artifact <artifact-id> --pattern <text> [--regex] [--ignore-case] --json
  embedded-agent log context --project <id> --artifact <artifact-id> --line <n> [--before 40] [--after 40] --json
  embedded-agent can driver-list --json
  embedded-agent can driver-probe --driver controlcan|zcanpro|virtual --json
  embedded-agent can device-probe --driver controlcan|zcanpro [--device-model <id>] [--device-index <index>] --json
  embedded-agent can self-test --json
  embedded-agent can check-env --driver controlcan|zcanpro|virtual --json
  embedded-agent can monitor --driver <name> --duration <seconds> [--id <can-id>] --json
  embedded-agent can send --driver <name> --frame <ID#DATA> --require-confirm [--confirm] --json
  embedded-agent can uds-ecu --driver <name> --rxid <id> --txid <id> --profile <name> --idle-timeout <seconds> --require-confirm [--confirm] --json
  embedded-agent can uds-tester --driver <name> --txid <id> --rxid <id> --request <hex> --require-confirm [--confirm] --json
  embedded-agent rtt capture --project <id> --target mcu [--wait-ms 12000] [--reset --require-confirm --confirm] --json
  embedded-agent flash --project <id> --target mcu|mpu --require-confirm [--confirm] --json

Environment:
  EMBEDDED_AGENT_HOST          Required SSH host alias
  EMBEDDED_AGENT_REMOTE_PREFIX Windows install root; derives the stable entry path
  EMBEDDED_AGENT_REMOTE_SCRIPT Optional explicit Windows entry path
  Windows state and backend paths are owned by the installed stable launcher.
  EMBEDDED_AGENT_CONNECT_TIMEOUT SSH connect timeout in seconds, default: 8

USAGE
}

emit_transport_failure() {
  local transport_exit="$1"
  if [[ "$transport_exit" -ne 255 ]]; then
    return
  fi

  if [[ "$json_requested" -eq 1 ]]; then
    python3 - "$transport_exit" "$host" "$connect_timeout" <<'PY'
import json
import sys
from datetime import datetime, timezone

print(json.dumps({
    "schema_version": "embedded-capability-result/v1",
    "contract_version": "1.0.0",
    "capability_id": "agent.transport",
    "phase": "execute",
    "state": "failed",
    "ok": False,
    "operation": "agent-transport",
    "exit_code": int(sys.argv[1]),
    "timestamp": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "evidence": [],
    "error": {
        "code": "SSH_TRANSPORT_UNAVAILABLE",
        "category": "transport",
        "message": "SSH transport failed before the Windows embedded-agent started",
        "retryable": True,
        "next_hint": "Check the network or VPN, Windows host power, and the SSH host mapping before retrying",
    },
    "host": sys.argv[2],
    "connect_timeout_seconds": int(sys.argv[3]),
    "retryable": True,
    "error_code": "SSH_TRANSPORT_UNAVAILABLE",
    "first_failure": "SSH transport failed before the Windows embedded-agent started",
    "next_hint": "Check the network or VPN, Windows host power, and the SSH host mapping before retrying",
}, ensure_ascii=False, separators=(",", ":")))
PY
  else
    echo "embedded-agent: SSH transport to ${host} failed before the Windows Agent started" >&2
  fi
}

ssh_options=(
  -o BatchMode=yes
  -o ConnectionAttempts=1
  -o "ConnectTimeout=${connect_timeout}"
  -o ServerAliveInterval=5
  -o ServerAliveCountMax=2
  -o LogLevel=ERROR
)

run_remote() {
  local encoded
  encoded="$(python3 - "$@" <<'PY'
import base64
import json
import sys

payload = json.dumps(
    {"args": sys.argv[1:]},
    ensure_ascii=True,
    separators=(",", ":"),
)
print(base64.b64encode(payload.encode("utf-8")).decode("ascii"))
PY
)"
  ssh "${ssh_options[@]}" "$host" py -3 "$remote_script" --payload-b64 "$encoded"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
  usage
  if [[ $# -lt 1 ]]; then
    exit 2
  fi
  exit 0
fi

args=("$@")
json_requested=0
for arg in "${args[@]}"; do
  if [[ "$arg" == "--json" ]]; then
    json_requested=1
    break
  fi
done

if [[ -z "$host" || -z "$remote_script" ]]; then
  if [[ "$json_requested" -eq 1 ]]; then
    python3 - <<'PY'
import json
from datetime import datetime, timezone

print(json.dumps({
    "schema_version": "embedded-capability-result/v1",
    "contract_version": "1.0.0",
    "capability_id": "agent.transport",
    "phase": "execute",
    "state": "failed",
    "ok": False,
    "operation": "agent-transport",
    "exit_code": 2,
    "timestamp": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "evidence": [],
    "error": {
        "code": "SSH_TRANSPORT_CONFIGURATION_MISSING",
        "category": "invalid_request",
        "message": "Configure EMBEDDED_AGENT_HOST and EMBEDDED_AGENT_REMOTE_PREFIX or EMBEDDED_AGENT_REMOTE_SCRIPT",
        "retryable": False,
    },
    "error_code": "SSH_TRANSPORT_CONFIGURATION_MISSING",
    "first_failure": "Configure EMBEDDED_AGENT_HOST and EMBEDDED_AGENT_REMOTE_PREFIX or EMBEDDED_AGENT_REMOTE_SCRIPT",
}, ensure_ascii=False, separators=(",", ":")))
PY
  else
    echo "embedded-agent: configure EMBEDDED_AGENT_HOST and EMBEDDED_AGENT_REMOTE_PREFIX or EMBEDDED_AGENT_REMOTE_SCRIPT" >&2
  fi
  exit 2
fi

if [[ ! "$connect_timeout" =~ ^[1-9][0-9]*$ ]]; then
  if [[ "$json_requested" -eq 1 ]]; then
    python3 - "$connect_timeout" <<'PY'
import json
import sys
from datetime import datetime, timezone

print(json.dumps({
    "schema_version": "embedded-capability-result/v1",
    "contract_version": "1.0.0",
    "capability_id": "agent.transport",
    "phase": "execute",
    "state": "failed",
    "ok": False,
    "operation": "agent-transport",
    "exit_code": 2,
    "timestamp": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "evidence": [],
    "error": {
        "code": "SSH_TRANSPORT_CONFIGURATION_INVALID",
        "category": "invalid_request",
        "message": "EMBEDDED_AGENT_CONNECT_TIMEOUT must be a positive integer",
        "retryable": False,
    },
    "error_code": "SSH_TRANSPORT_CONFIGURATION_INVALID",
    "first_failure": "EMBEDDED_AGENT_CONNECT_TIMEOUT must be a positive integer",
    "configured_value": sys.argv[1],
}, ensure_ascii=False, separators=(",", ":")))
PY
  else
    echo "embedded-agent: EMBEDDED_AGENT_CONNECT_TIMEOUT must be a positive integer" >&2
  fi
  exit 2
fi

if [[ "${args[0]}" == "flash" ]]; then
  has_require=0
  for arg in "${args[@]}"; do
    if [[ "$arg" == "--require-confirm" ]]; then
      has_require=1
      break
    fi
  done
  if [[ "$has_require" -ne 1 ]]; then
    echo "embedded-agent: flash requires --require-confirm" >&2
    exit 2
  fi
fi

if run_remote "${args[@]}"; then
  exit 0
else
  transport_exit=$?
fi
emit_transport_failure "$transport_exit"
exit "$transport_exit"
