#!/usr/bin/env bash
set -euo pipefail

windows_prefix_wsl="${WSL_EMBEDDED_AGENT_PREFIX:-}"
windows_script_wsl="${WSL_EMBEDDED_AGENT_SCRIPT:-${windows_prefix_wsl:+${windows_prefix_wsl}/bin/embedded-agent.py}}"
windows_cmd="${WSL_WINDOWS_CMD:-/mnt/c/Windows/System32/cmd.exe}"

fail() {
  local message="$1"
  if [[ " $* " == *" --json "* ]]; then
    python3 - "$message" <<'PY'
import json
import sys
from datetime import datetime, timezone

print(json.dumps({
    "schema_version": "embedded-capability-result/v1",
    "contract_version": "1.0.0",
    "capability_id": "agent.transport",
    "phase": "execute",
    "state": "failed",
    "ok": False,
    "operation": "agent-transport",
    "exit_code": 127,
    "timestamp": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "evidence": [],
    "error": {
        "code": "WSL_WINDOWS_INTEROP_UNAVAILABLE",
        "category": "availability",
        "message": sys.argv[1],
        "retryable": True,
    },
    "error_code": "WSL_WINDOWS_INTEROP_UNAVAILABLE",
    "first_failure": sys.argv[1],
}, ensure_ascii=False, separators=(",", ":")))
PY
  else
    printf 'embedded-agent: %s\n' "$message" >&2
  fi
  exit 127
}

[[ -n "$windows_script_wsl" ]] || fail "Set WSL_EMBEDDED_AGENT_PREFIX to the Windows install root" "$@"
[[ -f "$windows_script_wsl" ]] || fail "Windows embedded-agent entry not found: $windows_script_wsl" "$@"
[[ -x "$windows_cmd" ]] || fail "Windows cmd.exe not found: $windows_cmd" "$@"

if [[ -n "${WSL_WINDOWS_PY:-}" ]]; then
  windows_py="$WSL_WINDOWS_PY"
else
  windows_py_win="$(cd /mnt/c && "$windows_cmd" /d /s /c "where py" 2>/dev/null | tr -d '\r' | sed -n '1p')"
  [[ -n "$windows_py_win" ]] || fail "Windows Python launcher was not found" "$@"
  windows_py="$(wslpath -u "$windows_py_win")"
fi
[[ -x "$windows_py" ]] || fail "Windows Python launcher is not executable: $windows_py" "$@"

windows_script="$(wslpath -w "$windows_script_wsl")"
payload="$(python3 - "$@" <<'PY'
import base64
import json
import sys

value = {"args": sys.argv[1:]}
encoded = json.dumps(value, ensure_ascii=True, separators=(",", ":")).encode("utf-8")
print(base64.b64encode(encoded).decode("ascii"))
PY
)"

exec "$windows_py" -3 "$windows_script" --payload-b64 "$payload"
