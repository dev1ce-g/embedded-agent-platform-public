{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "Embedded Capability Catalog v1",
  "type": "object",
  "required": ["schema_version", "contract_version", "generated_at", "runtime", "capabilities"],
  "properties": {
    "schema_version": {"const": "embedded-capability-catalog/v1"},
    "contract_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "runtime": {
      "type": "object",
      "required": ["id", "version", "adapter_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "supported_contract_versions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "revision", "title", "risk_level", "execution_modes", "phases", "input_schema", "output_schema", "availability"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/capability_id"},
          "revision": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "risk_level": {"$ref": "common.schema.json#/$defs/risk_level"},
          "execution_modes": {
            "type": "array",
            "items": {"type": "string", "enum": ["sync", "async"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "phases": {
            "type": "array",
            "items": {"type": "string", "enum": ["preflight", "execute", "status", "evidence"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "input_schema": {"type": "string", "minLength": 1},
          "output_schema": {"type": "string", "minLength": 1},
          "side_effects": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "availability": {
            "type": "object",
            "required": ["state", "blockers"],
            "properties": {
              "state": {"type": "string", "enum": ["ready", "degraded", "unavailable", "selection_required"]},
              "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
